table _Mõõdikud
	lineageTag: 2551044b-7945-4e24-819f-33094a8731fb

	/// Arvutab Maa-ameti andmete põhjal elamispindade dünaamilise keskmise turuväärtuse (nominaalse hinna) ruutmeetri kohta vastavalt valitud perioodile ja piirkonnale.
	measure Keskmine_m2_hind = AVERAGE('Kinnisvara'[Keskmine_m2_hind])
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 703810ad-9b88-4e86-b87b-6ad7167dbf1a

		annotation PBI_FormatHint = {"currencyCulture":"et-EE"}

	/// Statistikaameti andmetel põhinev aritmeetiline keskmine tarbijahinnaindeks, mis peegeldab üldist inflatsioonitaset ja elukalliduse muutust ajas.
	measure Keskmine_THI = AVERAGE('Tarbijahinnaindeks'[Keskmine_indeks])
		lineageTag: d4ff27e2-87a0-42e1-ab45-450896d2d342

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Kinnisvara keskmise ruutmeetri hinna kumulatiivne kasv võrreldes baasperioodiga (Aasta 2005 = 1.0 ehk 100%). Näitab, mitu korda on turuhind baasaastast alates tõusnud.
	measure Kinnisvarahinnaindeks =
			
			VAR BaasHind = CALCULATE([Keskmine_m2_hind], 'Aeg'[Aasta] = 2005)
			RETURN
			DIVIDE([Keskmine_m2_hind], BaasHind, 0)
		lineageTag: 5b8ceb19-0ce3-403e-ba25-67e06ca7efa3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Tarbijahinnaindeksi kumulatiivne kasv võrreldes baasperioodiga (Aasta 2005 = 1.0 ehk 100%). Näitab üldise elukalliduse ja tarbijakorvi mitmekordistumist ajas.
	measure THI =
			
			VAR BaasTHI = CALCULATE([Keskmine_THI], 'Aeg'[Aasta] = 2005)
			RETURN
			DIVIDE([Keskmine_THI], BaasTHI, 0)
		lineageTag: 58b3b3f2-7aea-428b-a74a-fd7f13a73656

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Brutopalga indeks' =
			
			VAR JooksevPalk = AVERAGE('Palk'[Keskmine_palk])
			VAR BaasPalk = CALCULATE(AVERAGE('Palk'[Keskmine_palk]), 'Aeg'[Aasta] = 2005)
			RETURN
			DIVIDE(JooksevPalk, BaasPalk, 0)
		lineageTag: 7204509f-de98-4972-ab81-86775e31d239

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition _Mõõdikud = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

